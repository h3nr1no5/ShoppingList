# Shopping List App - Frontend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API endpoint URL
# In development: defaults to /api (proxied to http://localhost:8000 by Vite)
# In production: set to your deployed API URL
# Example: VITE_API_URL=https://shoppinglist-api.your-region.azurecontainerapps.io
# VITE_API_URL=

# =============================================================================
# DEVELOPMENT SERVER
# =============================================================================

# Port for the Vite development server (default: 5173)
# This is used when running `npm run dev` locally
# VITE_PORT=5173

# =============================================================================
# PRODUCTION SERVER
# =============================================================================

# Port for the production Express server (default: 8080)
# This serves the built frontend and proxies API requests
# Used when running `node server.js` in production
# PORT=8080