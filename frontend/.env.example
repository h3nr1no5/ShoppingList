# Example environment file for frontend
# Copy this to .env and update with your actual API URL
#
# In production (set by infra/hooks/prepackage.sh during azd deploy):
# VITE_API_URL=https://your-api-container-app-url.region.azurecontainerapps.io
#
# In local development (Vite proxies /api to localhost:8000):
# VITE_API_URL=
#
# The frontend code (src/config/api.ts) reads this value at build time.
# - If set: API calls go to VITE_API_URL/api
# - If empty in dev: Vite proxy handles /api requests
# - If empty in production: throws an error (fail-fast)

VITE_API_URL=