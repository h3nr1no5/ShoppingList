# Shopping List App - Frontend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API endpoint URL (optional)
# In same-origin architecture, this defaults to /api (served by FastAPI)
# Set this to override for local development or testing against a different backend
# Example: VITE_API_URL=http://localhost:8000
# VITE_API_URL=

# =============================================================================
# DEVELOPMENT SERVER
# =============================================================================

# Port for the Vite development server (default: 5173)
# This is used when running `npm run dev` locally
# VITE_PORT=5173