# Database Configuration
# Option 1: Direct PostgreSQL URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shoppinglist

# Option 2: Azure PostgreSQL connection string (will be parsed automatically)
# AZURE_POSTGRESQL_CONNECTIONSTRING=postgresql://user:password@host:port/dbname?sslmode=require

# JWT Configuration (REQUIRED - must be set for production)
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=generate-a-secure-secret-key-here

# Token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: SQL echo for debugging
SQL_ECHO=false

# Registration Configuration (DEPRECATED - no longer enforced)
# Registration is now open to everyone. This setting is ignored.
# REGISTRATION_KEY=your-optional-invite-code