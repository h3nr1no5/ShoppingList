# Shopping List App - Backend Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# REQUIRED
# =============================================================================

# JWT signing key for token generation
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NOTE: This is required at import time - the server will fail to start without it
SECRET_KEY=your-secret-key-here

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL connection string (async)
# Format: postgresql+asyncpg://user:password@host:port/database
# Default for local development:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shoppinglist

# Supabase PostgreSQL (for local development against Supabase)
# URL format (from Supabase project settings → Database → Connection string):
# DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-xx-xx-xx.pooler.supabase.com:6543/postgres
# NOTE: Supabase uses self-signed certificates on its connection pooler.
# When "supabase" is detected in the URL, SSL verification is disabled
# (TLS encryption is still active). This means the connection is encrypted
# but NOT authenticated against a CA — a MITM risk. For local dev only.

# Azure PostgreSQL connection string (optional, overrides DATABASE_URL if set)
# The connection string will be parsed to extract DATABASE_URL
# AZURE_POSTGRESQL_CONNECTIONSTRING=your-azure-connection-string

# =============================================================================
# AUTHENTICATION
# =============================================================================

# Invite code required for user registration
# Set this to restrict registration to invited users only
# REGISTRATION_KEY=your-registration-key

# JWT token expiration time in minutes
# Default: 30
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# PASSWORD RESET (Resend.com)
# =============================================================================

# Resend.com API key for sending password reset emails
# Optional in development — if not set, reset links are logged to the server console
# RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender email address for password reset emails
# Default: onboarding@resend.dev (or your verified domain sender)
# FROM_EMAIL=noreply@example.com

# Frontend URL used when building password reset links
# Default: http://localhost:5173
# FRONTEND_URL=http://localhost:5173

# Password reset JWT expiry in minutes
# Default: 15
# RESET_TOKEN_EXPIRE_MINUTES=15

# Rate limit for forgot-password endpoint (requests per minute per IP)
# Default: 3/minute
# FORGOT_PASSWORD_RATE_LIMIT=3/minute

# Rate limit for reset-password endpoint (requests per minute per IP)
# Default: 5/minute
# RESET_PASSWORD_RATE_LIMIT=5/minute

# =============================================================================
# E2E TESTING
# =============================================================================

# Password for the post-deployment e2e test user on Azure
# Synced to Key Vault by infra/hooks/set-env.sh during deploy
# Generate a strong random password
# E2E_TEST_PASSWORD=your-e2e-test-password

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# Comma-separated list of allowed origins for CORS
# Default: http://localhost:5173 (Vite dev server)
# ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# DEBUGGING
# =============================================================================

# Enable SQL query logging (true/false)
# Default: false
# SQL_ECHO=false