      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', format('{0}-api', parameters('envName'))), '2022-03-01').configuration.ingress.fqdn]"
    },
    "WEB_APP_URL": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', format('{0}-web', parameters('envName'))), '2022-03-01').configuration.ingress.fqdn]"
    },
    "DATABASE_HOST": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('envName'))), '2023-03-01-preview').fullyQualifiedDomainName]"
    },
    "DATABASE_NAME": {
