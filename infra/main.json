{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "15978998592919654661"
    }
  },
  "parameters": {
    "envName": {
      "type": "string",
      "defaultValue": "shoppinglist",
      "metadata": {
        "description": "Environment name"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for resources"
      }
    },
    "postgresAdminLogin": {
      "type": "string",
      "metadata": {
        "description": "Azure PostgreSQL administrator login"
      }
    },
    "postgresAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Azure PostgreSQL administrator password"
      }
    },
    "image": {
      "type": "string",
      "defaultValue": "nginx:latest",
      "metadata": {
        "description": "Container image URL (e.g., ghcr.io/owner/repo:sha)"
      }
    },
    "registryServer": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Container registry server (e.g., ghcr.io)"
      }
    },
    "registryUsername": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Container registry username"
      }
    },
    "registryPassword": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Container registry password"
      }
    },
    "secretKey": {
      "type": "securestring",
      "metadata": {
        "description": "SECRET_KEY for JWT signing"
      }
    },
    "registrationKey": {
      "type": "securestring",
      "metadata": {
        "description": "REGISTRATION_KEY for invite-only registration"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2023-03-01-preview",
      "name": "[format('{0}/{1}', format('{0}-postgres', parameters('envName')), 'shoppinglist')]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.UTF8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('envName')))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2022-03-01",
      "name": "[format('{0}-env', parameters('envName'))]",
      "location": "[parameters('location')]",
      "properties": {}
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}-app', parameters('envName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": {
        "azd-service-name": "app"
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('envName')))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto"
          },
          "registries": "[if(not(empty(parameters('registryPassword'))), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUsername'), 'passwordSecretRef', 'registry-password')), createArray())]",
          "secrets": "[if(not(empty(parameters('registryPassword'))), createArray(createObject('name', 'registry-password', 'value', parameters('registryPassword'))), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "[format('{0}-app', parameters('envName'))]",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "env": [
                {
                  "name": "SECRET_KEY",
                  "value": "[parameters('secretKey')]"
                },
                {
                  "name": "REGISTRATION_KEY",
                  "value": "[parameters('registrationKey')]"
                },
                {
                  "name": "DATABASE_URL",
                  "value": "[format('postgresql+asyncpg://{0}:{1}@{2}:5432/shoppinglist?sslmode=require', parameters('postgresAdminLogin'), parameters('postgresAdminPassword'), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('envName'))), '2023-03-01-preview').fullyQualifiedDomainName)]"
                },
                {
                  "name": "STATIC_DIR",
                  "value": "static"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8000
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 30,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8000
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('envName')))]",
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('envName')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2023-03-01-preview",
      "name": "[format('{0}-postgres', parameters('envName'))]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "15",
        "administratorLogin": "[parameters('postgresAdminLogin')]",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "storage": {
          "storageSizeGB": 32
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2023-03-01-preview",
      "name": "[format('{0}-postgres/AllowAzureServices', parameters('envName'))]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      }
    }
  ],
  "outputs": {
    "APP_URL": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', format('{0}-app', parameters('envName'))), '2023-05-01').configuration.ingress.fqdn]"
    },
    "DATABASE_HOST": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-postgres', parameters('envName'))), '2023-03-01-preview').fullyQualifiedDomainName]"
    },
    "DATABASE_NAME": {
      "type": "string",
      "value": "shoppinglist"
    },
    "DATABASE_USER": {
      "type": "string",
      "metadata": {
        "description": "Database admin username — treat as sensitive"
      },
      "value": "[parameters('postgresAdminLogin')]"
    }
  }
}